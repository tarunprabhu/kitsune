//===----------------------------------------------------------------------===//
//
// Documentation for options available to `cc1` in Kitsune's C/C++ frontends.
// This is used to generate the HTML options reference page.
//
//===----------------------------------------------------------------------===//

def GlobalDocumentation {
  code Intro =[{..
  -------------------------------------------------------------------
  NOTE: This file is automatically generated by running clang-tblgen
  -gen-kitsune-opt-docs. Do not edit this file by hand!!
  -------------------------------------------------------------------

==================================
CC1 Command-Line Options Reference
==================================
.. contents::
   :local:

Introduction
============

Command-line options that can be used with the underlying compiler, `-cc1`, in
Kitsune's C and C++ compiler drivers, i.e. `kitcc` and `kit++` respectively.
Some options can only be used with these drivers.

}];

  string Program = "Kitsune (C/C++)";

  list<string> VisibilityMask = ["CC1Option"];

  // We show the hidden options as well because `-cc1` is intended for
  // developers. However, if options are marked as `unsupported`, or `ignored`,
  // it's not clear what is to be gained by displaying them.
  list<string> IgnoreFlags = ["Unsupported", "Ignored"];

  // Ignore groups that are either not relevant for Kitsune, or contain options
  // that are not supported by Kitsune.
  list<string> IgnoreGroups = ["cuda_Group", "dxc_Group", "gfortran_Group", "hip_Group", "offload_Group", "opencl_Group", "sycl_Group", "hlsl_Group"];
}

#define GENERATING_DOCS
include "Options.td"
