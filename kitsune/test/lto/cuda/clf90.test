# REQUIRES: kitfc
#
# Ensure that the command line options specific to the cuda tapir target are
# correctly handled when compiling Fortran with -flto.
#
# RUN: %kitfc -### --tapir=cuda --tapir-cuda-arch=sm_80 -O2 -flto \
# RUN:     %S/../input/add.f90 %S/../input/main.f90 2>&1 \
# RUN:     | FileCheck %s -check-prefixes=ALL
#
# RUN: %kitfc -### --tapir=cuda -O2 -flto \
# RUN:     %S/../input/add.f90 %S/../input/main.f90 \
# RUN:     --tapir-cuda-arch=sm_72 2>&1 \
# RUN:     | FileCheck %s -check-prefixes=ALL,CUDA_ARCH
#
# ALL: /ld{{(64)?}}.lld"
# ALL-SAME: "-mllvm" "--tapir=cuda"
# CUDA_ARCH: "-mllvm" "--tapir-cuda-arch=sm_72"
