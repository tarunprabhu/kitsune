# REQUIRES: kitfc
#
# FIXME: The Fortran source does not exist yet. When full Fortran support is
# enabled in Kitsune, write those files and remove the xfail here.
# XFAIL: *
#
# Check a standard "end-to-end" lowering using LTO. We emit LLVM from LLD
# because running the linker may not work on systems with non-standard
# sysroots.
#
# mkdir -p %t/a.bc
#
# RUN: %kitfc -ftapir=cuda -O2 -flto -Wl,--lto-emit-llvm -o %t/a.bc \
# RUN:     --tapir-cuda-arch=sm_72 \
# RUN:     %S/../input/add.f90 %S/../input/main.f90
# RUN: opt -S %t/a.bc | FileCheck %s
#
# CHECK: call {{.+}} @__kitcuda_launch_kernel