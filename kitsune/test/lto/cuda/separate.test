# Check that the tapir lowering passes are not run when compiling to an "object
# file" (the prelink phase). When performing the actual link, the lowering
# passes should be run.
#
# RUN: mkdir -p %t
#
# RUN: %kitxx -c -flto --tapir=cuda -O2 --tapir-verbose %S/../input/add.cpp \
# RUN:     --tapir-cuda-arch=sm_72 \
# RUN:     -o %t/add.o 2>&1 \
# RUN:     | FileCheck %s --check-prefixes=NO-LOWER --allow-empty
#
# RUN: %kitxx -c -flto --tapir=cuda -O2 --tapir-verbose %S/../input/main.cpp \
# RUN:     --tapir-cuda-arch=sm_72 \
# RUN:     -o %t/main.o 2>&1 \
# RUN:     | FileCheck %s --check-prefixes=NO-LOWER --allow-empty
#
# RUN: %kitxx -flto -O2 %t/main.o %t/add.o -o %t/a.bc %sysroot \
# RUN:     -Wl,--lto-emit-llvm \
# RUN:     --tapir=cuda --tapir-cuda-arch=sm_72 --tapir-verbose 2>&1 \
# RUN:     | FileCheck %s --check-prefixes=LOWER
#
# RUN: llvm-dis -o - %t/a.bc | FileCheck %s --check-prefix=LAUNCH
#
# NO-LOWER-NOT: 'cuda' tapir target options
# LOWER: 'cuda' tapir target options
# LAUNCH: call {{.+}} @__kitcuda_launch_kernel
