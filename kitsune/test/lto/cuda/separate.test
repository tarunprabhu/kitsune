# Check a "standard" lowering using LTO, but where each file is compiled
# separately.
#
# RUN: mkdir -p %t
#
# RUN: %kitxx -c -flto -O2 -o %t/add.o %S/../input/add.cpp \
# RUN:     --tapir=cuda --tapir-cuda-arch=sm_72
#
# RUN: %kitxx -c -flto -O2 -o %t/main.o %S/../input/main.cpp \
# RUN:     --tapir=cuda --tapir-cuda-arch=sm_72
#
# RUN: %kitxx -flto -O2 %t/main.o %t/add.o -o %t/a.bc %sysroot \
# RUN:     --tapir=cuda --tapir-cuda-arch=sm_72 2>&1 \
# RUN:     -Wl,--lto-emit-llvm
#
# RUN: llvm-dis -o - %t/add.o | FileCheck %s --check-prefix NO-LAUNCH
# RUN: llvm-dis -o - %t/main.o | FileCheck %s --check-prefix MAIN
# RUN: llvm-dis -o - %t/a.bc | FileCheck %s --check-prefix LAUNCH
#
# NO-LAUNCH-NOT: @llvm.kit.async.launch.kernel
# MAIN: call void @_Z6vecaddN7kitsune
# LAUNCH: call {{.+}} @llvm.kit.async.launch.kernel(i32 2,
