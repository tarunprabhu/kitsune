# Check a standard "end-to-end" lowering using LTO. We emit LLVM from LLD
# because running the linker may not work on systems with non-standard
# sysroots.
#
# RUN: %kitxx -ftapir=cuda -O2 -flto -o - -Wl,--lto-emit-llvm \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp 2>&1 \
# RUN:     | opt -S \
# RUN:     | FileCheck %s
#
# CHECK: call {{.+}} @__kitcuda_launch_kernel
