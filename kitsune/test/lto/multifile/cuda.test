# REQUIRES: kitsune-cuda
#
# We choose to emit LLVM in these tests because actually linking the object
# files could cause failures on systems with non-standard sysroots
#
# RUN: %kitxx -v -flto --tapir=cuda -O2 %S/main.cpp %S/add.cpp -o /dev/null \
# RUN:     --tapir-verbose -Wl,--lto-emit-llvm 2>&1 \
# RUN:     | FileCheck %s -check-prefixes=ALL,STANDARD
#
# RUN: %kitxx -v -flto --tapir=cuda -O2 %S/main.cpp %S/add.cpp -o /dev/null \
# RUN:     --tapir-verbose -ffp-contract=off -Wl,--lto-emit-llvm 2>&1 \
# RUN:     | FileCheck %s -check-prefixes=ALL,STANDARD
#
# RUN: %kitxx -v -flto --tapir=cuda -O2 %S/main.cpp %S/add.cpp -o /dev/null \
# RUN:     --tapir-verbose -ffp-contract=on -Wl,--lto-emit-llvm 2>&1 \
# RUN:     | FileCheck %s -check-prefixes=ALL,STANDARD
#
# RUN: %kitxx -v -flto --tapir=cuda -O2 %S/main.cpp %S/add.cpp -o /dev/null \
# RUN:     --tapir-verbose -ffp-contract=fast -Wl,--lto-emit-llvm 2>&1 \
# RUN:     | FileCheck %s -check-prefixes=ALL,FAST
#
# RUN: %kitxx -v -flto --tapir=cuda -O2 %S/main.cpp %S/add.cpp -o /dev/null \
# RUN:     --tapir-verbose -ffp-contract=fast-honor-pragmas 2>&1 \
# RUN:     -Wl,--lto-emit-llvm \
# RUN:     | FileCheck %s -check-prefixes=ALL,STANDARD
#
# ALL: /ld{{(64)?}}.lld
# ALL-SAME: --fp-contract=
# ALL: 'cuda' tapir target options
# STRICT: FP Fusion: strict
# STANDARD: FP Fusion: standard
# FAST: FP Fusion: fast
