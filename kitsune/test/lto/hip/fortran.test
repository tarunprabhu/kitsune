# REQUIRES: kitfc
#
# FIXME: Support to lower DO loops using tapir instructions has not been
# implemented yet.
# XFAIL: *
#
# Check a standard "end-to-end" lowering using LTO.
#
# RUN: %kitfc -O2 -flto -Wl,--lto-emit-llvm -o - %sysroot \
# RUN:     --tapir=hip --tapir-hip-arch=gfx90a \
# RUN:     %S/../input/add.f90 %S/../input/main.f90 \
# RUN:     | llvm-dis \
# RUN:     | FileCheck %s
#
# CHECK: call {{.+}} @__kithip_launch_kernel