# Check that the tapir lowering passes are not run when compiling to an "object
# file" (the prelink phase). When performing the actual link, the lowering
# passes should be run.
#
# We emit LLVM instead of doing an actual link because the latter can fail on
# systems with non-standard sysroots.
#
# RUN: mkdir -p %t
#
# RUN: %kitxx -c -flto --tapir=hip -O2 --tapir-verbose %S/../input/add.cpp \
# RUN:     -o %t/add.o 2>&1 \
# RUN:     | FileCheck %s --check-prefix=NO-LOWER --allow-empty
#
# RUN: %kitxx -c -flto --tapir=hip -O2 --tapir-verbose %S/../input/main.cpp \
# RUN:     -o %t/main.o 2>&1 \
# RUN:     | FileCheck %s --check-prefix=NO-LOWER --allow-empty
#
# RUN: %kitxx -flto -O2 %t/main.o %t/add.o -o %t/a.bc %sysroot \
# RUN:     -Wl,--lto-emit-llvm \
# RUN:     --tapir=hip --tapir-hip-arch=gfx90a --tapir-verbose 2>&1 \
# RUN:     | FileCheck %s --check-prefix=LOWER
#
# RUN: llvm-dis -o - %t/a.bc | FileCheck %s --check-prefix=LAUNCH
#
# NO-LOWER-NOT: 'hip' tapir target options
# LOWER: 'hip' tapir target options
# LAUNCH: call {{.+}} @__kithip_launch_kernel
