# Check a "standard" lowering using LTO, but where each file is compiled
# separately.
#
# RUN: mkdir -p %t
#
# RUN: %kitxx -c -flto -O2 -o %t/add.o %S/../input/add.cpp \
# RUN:      --tapir=hip --tapir-hip-arch=gfx1103
# RUN: llvm-dis -o - %t/add.o | FileCheck %s --check-prefix NO-LAUNCH
#
# NO-LAUNCH-NOT: @llvm.kit.async.gpu.kernel.launch
#
#
# RUN: %kitxx -c -flto -O2 -o %t/main.o %S/../input/main.cpp \
# RUN:      --tapir=hip --tapir-hip-arch=gfx1103
# RUN: llvm-dis -o - %t/main.o | FileCheck %s --check-prefix MAIN
#
# MAIN: call void @_Z6vecaddN7kitsune
#
#
# RUN: %kitxx -flto -O2 %t/main.o %t/add.o %sysroot \
# RUN:     --tapir=hip --tapir-hip-arch=gfx90a \
# RUN:     -Wl,--lto-emit-llvm -o - \
# RUN:     | llvm-dis -o - \
# RUN:     | FileCheck %s --check-prefix LAUNCH
#
# LAUNCH: call {{.+}} @llvm.kit.async.gpu.kernel.launch(i32 4,
