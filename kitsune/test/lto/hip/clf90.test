# REQUIRES: kitfc
#
# Ensure that the command line options specific to the hip tapir target are
# correctly handled when compiling Fortran with -flto.
#
# RUN: %kitfc -### -ftapir=hip -O2 -flto 2>&1 \
# RUN:     %S/../input/add.f90 %S/../input/main.f90 \
# RUN:     | FileCheck %s -check-prefixes=ALL
#
# RUN: %kitfc -### -ftapir=hip -O2 -flto \
# RUN:     %S/../input/add.f90 %S/../input/main.f90 \
# RUN:     --tapir-hip-arch=gfx906 2>&1 \
# RUN:     | FileCheck %s -check-prefixes=ALL,HIP_ARCH
#
# RUN: %kitfc -### -ftapir=hip -O2 -flto \
# RUN:     %S/../input/add.f90 %S/../input/main.f90 \
# RUN:     --tapir-gpu-tpb=64 2>&1 \
# RUN:     | FileCheck %s -check-prefixes=ALL,TPB
#
# RUN: %kitfc -### -ftapir=hip -O2 -flto \
# RUN:     %S/../input/add.f90 %S/../input/main.f90 \
# RUN:     --tapir-gpu-max-tpb=128 2>&1 \
# RUN:     | FileCheck %s -check-prefixes=ALL,MTPB
#
# RUN: %kitfc -### --tapir=hip -O2 -flto \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp \
# RUN:     --tapir-hip-sramecc=off 2>&1 \
# RUN:     | FileCheck %s -check-prefix SRAMECC_OFF
#
# RUN: %kitfc -### --tapir=hip -O2 -flto \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp \
# RUN:     --tapir-hip-sramecc=on 2>&1 \
# RUN:     | FileCheck %s -check-prefix SRAMECC_ON
#
# RUN: %kitfc -### --tapir=hip -O2 -flto \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp \
# RUN:     --tapir-hip-sramecc=any 2>&1 \
# RUN:     | FileCheck %s -check-prefix SRAMECC_ANY
#
# RUN: %kitfc -### --tapir=hip -O2 -flto \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp \
# RUN:     --tapir-hip-xnack=off 2>&1 \
# RUN:     | FileCheck %s -check-prefix XNACK_OFF
#
# RUN: %kitfc -### --tapir=hip -O2 -flto \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp \
# RUN:     --tapir-hip-xnack=on 2>&1 \
# RUN:     | FileCheck %s -check-prefix XNACK_ON
#
# RUN: %kitfc -### --tapir=hip -O2 -flto \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp \
# RUN:     --tapir-hip-xnack=any 2>&1 \
# RUN:     | FileCheck %s -check-prefix XNACK_ANY
#
# RUN: %kitfc -### --tapir=hip -O2 -flto \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp \
# RUN:     --tapir-hip-arch=gfx1103 --tapir-hip-wavefront64 2>&1 \
# RUN:     | FileCheck %s -check-prefix W_64
#
# RUN: %kitfc -### --tapir=hip -O2 -flto \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp \
# RUN:     --tapir-hip-arch=gfx1103 --tapir-hip-wavefront32 2>&1 \
# RUN:     | FileCheck %s -check-prefix W_32
#
# RUN: %kitfc -### --tapir=hip -O2 -flto \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp \
# RUN:     --tapir-hip-abi-version=5 2>&1 \
# RUN:     | FileCheck %s -check-prefix ABI_V5
#
# The path to LLD is passed to the tapir target, so "ld(64)?.lld" will match
# that. To ensure that this only matches the actual link line, check that
# "--dynamic-linker" is on the same line.
#
# ALL: /ld{{(64)?}}.lld"{{.+}}"-dynamic-linker"
# ALL-SAME: "-mllvm" "--tapir=hip"
# HIP_ARCH: "-mllvm" "--tapir-hip-arch=gfx906"
# TPB: "-mllvm" "--tapir-gpu-tpb=64"
# MTPB: "-mllvm" "--tapir-gpu-max-tpb=128"
# SRAMECC_OFF: "-mllvm" "--tapir-hip-sramecc=off"
# SRAMECC_ON: "-mllvm" "--tapir-hip-sramecc=on"
# SRAMECC_ANY: "-mllvm" "--tapir-hip-sramecc=any"
# XNACK_OFF: "-mllvm" "--tapir-hip-xnack=off"
# XNACK_ON: "-mllvm" "--tapir-hip-xnack=on"
# XNACK_ANY: "-mllvm" "--tapir-hip-xnack=any"
# W_64: "-mllvm" "--tapir-hip-runtime-bcs={{.*}}/oclc_wavefrontsize64_on.bc{{.*}}"
# W_32: "-mllvm" "--tapir-hip-runtime-bcs={{.*}}/oclc_wavefrontsize64_off.bc{{.*}}"
# ABI_V5: "-mllvm" "--tapir-hip-runtime-bcs={{.*}}/oclc_abi_version_500.bc{{.*}}"
