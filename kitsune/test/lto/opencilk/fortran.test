# REQUIRES: kitfc
#
# FIXME: Support to lower DO loops using tapir instructions has not been
# implemented yet.
# XFAIL: *
#
# Check a standard lowering using LTO.
#
# RUN: %kitfc --tapir=opencilk -O2 -flto -Wl,--lto-emit-llvm -o - %sysroot \
# RUN:     %S/../input/add.f90 %S/../input/main.f90 \
# RUN:     | llvm-dis -o - \
# RUN:     | FileCheck %s
#
# CHECK: call void @__cilkrts_sync
