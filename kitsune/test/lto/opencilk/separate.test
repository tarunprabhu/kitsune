# Check a "standard" lowering using LTO, but where each file is compiled
# separately.
#
# RUN: mkdir -p %t
#
# RUN: %kitxx -c -flto --tapir=opencilk -O2 -o %t/add.o %S/../input/add.cpp
#
# RUN: %kitxx -c -flto --tapir=opencilk -O2 -o %t/main.o %S/../input/main.cpp
#
# RUN: %kitxx -flto --tapir=opencilk -O2 %t/main.o %t/add.o -o %t/a.bc %sysroot \
# RUN:     -Wl,--lto-emit-llvm
#
# RUN: llvm-dis -o - %t/add.o | FileCheck %s --check-prefix TAPIR
# RUN: llvm-dis -o - %t/main.o | FileCheck %s --check-prefix MAIN
# RUN: llvm-dis -o - %t/a.bc | FileCheck %s --check-prefix CILKRTS
#
# TAPIR: detach within
# TAPIR: reattach within
# TAPIR: sync within
# MAIN: call void @_Z6vecaddN7kitsune
# CILKRTS: call void @__cilkrts_sync
