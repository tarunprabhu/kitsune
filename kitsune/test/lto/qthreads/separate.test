# Check a "standard" lowering using LTO, but where each file is compiled
# separately. We check the output of the loop spawning pass rather than the
# final result which will include the effect of some cleanup passes run after
# loop spawning.
#
# RUN: mkdir -p %t
#
# RUN: %kitxx -flto --tapir=qthreads -fno-inline -O2 %sysroot \
# RUN:     -c -o %t/add.o  %S/../input/add.cpp
# RUN: llvm-dis -o - %t/add.o | FileCheck %s --check-prefix TAPIR
#
# TAPIR: detach within
# TAPIR: reattach within
# TAPIR: sync within
#
#
# RUN: %kitxx -flto --tapir=qthreads -fno-inline -O2 %sysroot \
# RUN:     -c -o %t/main.o %S/../input/main.cpp
# RUN: llvm-dis -o - %t/main.o | FileCheck %s --check-prefix MAIN
#
# MAIN: call void @_Z6vecadd
#
#
# RUN: %kitxx -flto --tapir=qthreads -fno-inline -O2 %sysroot \
# RUN:     -Wl,--lto-emit-llvm -o /dev/null \
# RUN:     -Wl,-mllvm -Wl,--print-after=loop-spawning \
# RUN:     %t/main.o %t/add.o 2>&1 \
# RUN:     | FileCheck %s --check-prefixes=LOWERED
#
# LOWERED: define {{.*}}void @_Z6vecadd{{[^(]+}}(
# LOWERED-SAME: {{[^%]*}}%[[C:[^,]+]],
# LOWERED-SAME: {{[^%]*}}%[[A:[^,]+]],
# LOWERED-SAME: {{[^%]*}}%[[B:[^,]+]],
# LOWERED-SAME: i64 {{[^%]*}}%[[N:[^,]+]])
# LOWERED: %[[PACK:.+]] = alloca
# LOWERED-SAME: i64
# LOWERED-SAME: i64
# LOWERED-SAME: ptr addrspace(67)
# LOWERED-SAME: ptr addrspace(67)
# LOWERED-SAME: ptr addrspace(67)
# LOWERED-SAME: {{[}]}}
# LOWERED: %[[THRDS32:.+]] = tail call i32 @llvm.kit.cpu.num.threads(i32 32)
# LOWERED: %[[NUM_THREADS:.+]] = sext i32 %[[THRDS32]] to i64
# LOWERED: %[[PER_THREAD:.+]] = udiv i64 {{.+}}, %[[NUM_THREADS]]
# LOWERED-NEXT: %[[ARGPERTHRD:[0-9]+]] = getelementptr {{.*}}, ptr %[[PACK]]
# LOWERED-NEXT: store i64 %[[PER_THREAD]], ptr %[[ARGPERTHRD]]
# LOWERED-NEXT: %[[ARGN:[0-9]+]] = getelementptr {{.*}}, ptr %[[PACK]]
# LOWERED-NEXT: store i64 %[[N]], ptr %[[ARGN]]
# LOWERED-NEXT: %[[ARGA:[0-9]+]] = getelementptr {{.*}}, ptr %[[PACK]]
# LOWERED-NEXT: store ptr {{.*}}%[[A]], ptr %[[ARGA]]
# LOWERED-NEXT: %[[ARGB:[0-9]+]] = getelementptr {{.*}}, ptr %[[PACK]]
# LOWERED-NEXT: store ptr {{.*}}%[[B]], ptr %[[ARGB]]
# LOWERED-NEXT: %[[ARGC:[0-9]+]] = getelementptr {{.*}}, ptr %[[PACK]]
# LOWERED-NEXT: store ptr {{.*}}%[[C]], ptr %[[ARGC]]
# LOWERED: call void @llvm.kit.cpu.threads.launch(
# LOWERED-SANE: i32 32,
# LOWERED-SAME: ptr @[[OUTLINED:_Z6vecadd[^,]+]],
# LOWERED-SAME: i64 0,
# LOWERED-SAME: i64 %[[NUM_THREADS]],
# LOWERED-SAME: ptr %[[PACK]])
# LOWERED: ret void
#
# LOWERED: define internal fastcc void @[[OUTLINED:_Z6vecaddN7kitsune10mobile_ptrIdEES1_S1_m.outline_.ls1]](
# LOWERED-SAME: i64 %[[START:[^,]+]],
# LOWERED-SAME: i64 %[[END:[^,]+]],
# LOWERED-SAME: ptr {{.*}}%[[ARGS:[^)]+]])
# LOWERED: br label %[[BODY:.+]]
# LOWERED: [[BODY]]:
# LOWERED: %[[I:[0-9]+]] = phi i64
# LOWERED: %[[ARGPERTHRD:.+]] = getelementptr {{.*}}, ptr %[[ARGS]], i32 0, i32 0
# LOWERED: %[[PERTHRD:.+]] = load i64, ptr %[[ARGPERTHRD]]
# LOWERED: %[[ARGN:.+]] = getelementptr {{.*}}, ptr %[[ARGS]], i32 0, i32 1
# LOWERED: %[[N:.+]] = load i64, ptr %[[ARGN]]
# LOWERED: %[[ARGA:.+]] = getelementptr {{.*}}, ptr %[[ARGS]], i32 0, i32 2
# LOWERED: %[[PTRA:.+]] = load ptr addrspace(67), ptr %[[ARGA]]
# LOWERED: %[[ARGB:.+]] = getelementptr {{.*}}, ptr %[[ARGS]], i32 0, i32 3
# LOWERED: %[[PTRB:.+]] = load ptr addrspace(67), ptr %[[ARGB]]
# LOWERED: %[[ARGC:.+]] = getelementptr {{.*}}, ptr %[[ARGS]], i32 0, i32 4
# LOWERED: %[[PTRC:.+]] = load ptr addrspace(67), ptr %[[ARGC]]
# LOWERED: %[[IDXA:.+]] = {{.*}}call {{.+}} ptr @
# LOWERED: %[[VA:.+]] = load double, ptr %[[IDXA]]
# LOWERED: %[[IDXB:.+]] = {{.*}}call {{.+}} ptr @
# LOWERED: %[[VB:.+]] = load double, ptr %[[IDXB]]
# LOWERED: %[[SUM:.+]] = fadd double %[[VA]], %[[VB]]
# LOWERED: %[[IDXC:.+]] = {{.*}}call
# LOWERED: store double %[[SUM]], ptr %[[IDXC]]
# LOWERED: add {{.*}}i64 %[[I]], 1
# LOWERED: %[[ICMP:.+]] = icmp
# LOWERED: br i1 %[[ICMP]], label %[[EXIT:.+]], label %[[BODY]]
# LOWERED: [[EXIT]]:
# LOWERED: ret void
