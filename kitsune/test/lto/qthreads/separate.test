# Check a "standard" lowering using LTO, but where each file is compiled
# separately. We check the output of the loop spawning pass rather than the
# final result which will include the effect of some cleanup passes run after
# loop spawning. This is intentionally very basic because -fno-vectorize and
# -fno-unroll-loops are not fully respected when using LTO.
#
# RUN: mkdir -p %t
#
# RUN: %kitxx -flto --tapir=qthreads -O2 %sysroot \
# RUN:     -fno-inline -fno-vectorize -fno-unroll-loops \
# RUN:     -c -o %t/add.o  %S/../input/add.cpp
# RUN: llvm-dis -o - %t/add.o | FileCheck %s --check-prefix TAPIR
#
# TAPIR: detach within
# TAPIR: reattach within
# TAPIR: sync within
#
#
# RUN: %kitxx -flto --tapir=qthreads -O2 %sysroot \
# RUN:     -fno-inline -fno-vectorize -fno-unroll-loops \
# RUN:     -c -o %t/main.o %S/../input/main.cpp
# RUN: llvm-dis -o - %t/main.o | FileCheck %s --check-prefix MAIN
#
# MAIN: call void @vecadd
#
#
# RUN: %kitxx --tapir=qthreads -O2 -flto -o /dev/null %sysroot \
# RUN:     -fno-inline -fno-vectorize -fno-unroll-loops \
# RUN:     -Wl,--lto-emit-llvm \
# RUN:     -Wl,-mllvm -Wl,-print-after=loop-spawning \
# RUN:     %t/main.o %t/add.o 2>&1 \
# RUN:     | FileCheck %s
#
# CHECK: define internal fastcc void @vecadd(
# CHECK-SAME: ptr {{[^%]*}}%[[C:[^,]+]],
# CHECK-SAME: ptr {{[^%]*}}%[[A:[^,]+]],
# CHECK-SAME: ptr {{[^%]*}}%[[B:[^,]+]],
# CHECK-SAME: i64 {{[^%]*}}%[[N:[^,]+]])
# CHECK: %[[NUM_THREADS:.+]] = tail call i64 @llvm.kit.cpu.num.threads(i32 32)
# CHECK: %[[PER_THREAD:.+]] = udiv i64 {{.+}}, %[[NUM_THREADS]]
# CHECK: call void (i32, ptr, i64, i64, ...) @llvm.kit.cpu.threads.launch(
# CHECK-SAME: i32 32,
# CHECK-SAME: ptr @[[WRAPPER:[^,]+]],
# CHECK-SAME: i64 0,
# CHECK-SAME: i64 %[[NUM_THREADS]],
# CHECK-SAME: i64 %[[PER_THREAD]],
# CHECK-SAME: i64 %[[N]],
# CHECK-SAME: ptr %[[A]],
# CHECK-SAME: ptr %[[B]],
# CHECK-SAME: ptr %[[C]],
# CHECK: ret void
#
# CHECK: define internal fastcc void @[[WRAPPER]](
# CHECK-SAME: i64 {{[^%]*}}%[[BEG:[^,]+]],
# CHECK-SAME: i64 {{[^%]*}}%[[END:[^,]+]],
# CHECK-SAME: ptr {{[^%]*}}%[[ARGS:[^)]+]])
