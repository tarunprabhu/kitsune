# Check a standard lowering using LTO. We don't check as carefully as well do
# for the non-LTO lowering because simply passing -fno-vectorize and
# -fno-unroll-loops does not work as expected when using LTO.
#
# RUN: %kitxx --tapir=qthreads -O2 -flto -o /dev/null %sysroot \
# RUN:     -fno-inline -fno-vectorize -fno-unroll-loops \
# RUN:     -Wl,--lto-emit-llvm \
# RUN:     -Wl,-mllvm -Wl,-print-after=loop-spawning \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp 2>&1 \
# RUN:     | FileCheck %s
#
# CHECK: define internal fastcc void @vecadd(
# CHECK-SAME: ptr {{[^%]*}}%[[C:[^,]+]],
# CHECK-SAME: ptr {{[^%]*}}%[[A:[^,]+]],
# CHECK-SAME: ptr {{[^%]*}}%[[B:[^,]+]],
# CHECK-SAME: i64 {{[^%]*}}%[[N:[^,]+]])
# CHECK: %[[NUM_THREADS:.+]] = tail call i64 @llvm.kit.cpu.num.threads(i32 32)
# CHECK: %[[PER_THREAD:.+]] = udiv i64 {{.+}}, %[[NUM_THREADS]]
# CHECK: call void (i32, ptr, i64, i64, ...) @llvm.kit.cpu.threads.launch(
# CHECK-SAME: i32 32,
# CHECK-SAME: ptr @[[WRAPPER:[^,]+]],
# CHECK-SAME: i64 0,
# CHECK-SAME: i64 %[[NUM_THREADS]],
# CHECK-SAME: i64 %[[PER_THREAD]],
# CHECK-SAME: i64 %[[N]],
# CHECK-SAME: ptr %[[A]],
# CHECK-SAME: ptr %[[B]],
# CHECK-SAME: ptr %[[C]],
# CHECK: ret void
#
# CHECK: define internal fastcc void @[[WRAPPER]](
# CHECK-SAME: i64 {{[^%]*}}%[[BEG:[^,]+]],
# CHECK-SAME: i64 {{[^%]*}}%[[END:[^,]+]],
# CHECK-SAME: ptr {{[^%]*}}%[[ARGS:[^)]+]])
