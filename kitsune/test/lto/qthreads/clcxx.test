# Check that the command-line options specific to the qthreads tapir target are
# handled correctly when compiling with -flto.
#
# Currently, there are no command-line options specific to the qthreads tapir
# target, so just check that the tapir target itself is passed on to lld.
#
# RUN: %kitxx -### --tapir=qthreads -O2 -flto \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp 2>&1 \
# RUN:     | FileCheck %s -check-prefixes=ALL
#
# ALL: /ld{{(64)?}}.lld"
# ALL-SAME: "-mllvm" "--tapir=qthreads"
