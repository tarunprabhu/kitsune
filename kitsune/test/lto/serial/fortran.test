# REQUIRES: kitfc
#
# FIXME: Support to lower DO loops using tapir instructions has not been
# implemented yet.
# XFAIL: *
#
# Check a standard lowering using LTO.
#
# FIXME: Need to double-check exactly what to expect here, so, for now, just
# check that tapir instructions are removed.
#
# RUN: %kitfc --tapir=serial -O2 -flto -Wl,--lto-emit-llvm -o - %sysroot \
# RUN:     %S/../input/add.f90 %S/../input/main.f90 \
# RUN:     | llvm-dis \
# RUN:     | FileCheck %s
#
# CHECK-NOT: detach
# CHECK-NOT: reattach
# CHECK-NOT: {{[ ]}}sync{{[ ]}}
