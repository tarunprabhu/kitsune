# Check a standard lowering using LTO. We check the output of the loop spawning
# pass rather than the final result which will include the effect of some
# cleanup passes run after loop spawning. This is intentionally very basic
# because -fno-vectorize and -fno-unroll-loops are not fully respected when
# using LTO. We simply check that there are no Kitsune intrinsics in the lowered
# code.
#
# RUN: %kitxx --tapir=serial -O2 -flto -o /dev/null %sysroot \
# RUN:     -fno-inline -fno-vectorize -fno-unroll-loops \
# RUN:     -Wl,--lto-emit-llvm \
# RUN:     -Wl,-mllvm -Wl,-print-after=loop-spawning \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp 2>&1 \
# RUN:     | FileCheck %s
#
# CHECK: define {{.*}}void @vecadd(
# CHECK-SAME: ptr {{[^%]*}}%[[C:[^,]+]],
# CHECK-SAME: ptr {{[^%]*}}%[[A:[^,]+]],
# CHECK-SAME: ptr {{[^%]*}}%[[B:[^,]+]],
# CHECK-SAME: i64 {{[^%]*}}%[[N:[^,]+]])
# CHECK-NOT: @llvm.kit.
# CHECK: ret void
