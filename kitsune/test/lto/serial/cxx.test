# REQUIRES: !system-darwin
#
# ld64.lld does not support --lto-emit-llvm. We may implement this at some
# point, until then, disable this test there.
#
# ------------------------------------------------------------------------------
# Check a standard lowering using LTO.
#
# FIXME: Need to double-check exactly what to expect here, so, for now, just
# check that tapir instructions are removed.
#
# RUN: %kitxx --tapir=serial -O2 -flto -Wl,--lto-emit-llvm -o - %sysroot \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp \
# RUN:     | llvm-dis -o - \
# RUN:     | FileCheck %s
#
# CHECK-NOT: detach
# CHECK-NOT: reattach
# CHECK-NOT: {{[ ]}}sync{{[ ]}}
