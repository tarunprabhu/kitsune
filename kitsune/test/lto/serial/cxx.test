# REQUIRES: !system-darwin
# FIXME: ld64.lld does not support --lto-emit-llvm. We may implement this at
# some point. Until then, disable this test there.
#
# ------------------------------------------------------------------------------
# Check a standard lowering using LTO.
#
# RUN: %kitxx --tapir=serial -O2 -flto -fno-inline -o - %sysroot \
# RUN:     -Wl,--lto-emit-llvm \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp \
# RUN:     | llvm-dis -o - \
# RUN:     | FileCheck %s
#
# CHECK: define {{.*}}void @_Z6vecadd{{[^(]+}}(
# CHECK-SAME: ptr addrspace(67) writeonly %[[C:[^,]+]],
# CHECK-SAME: ptr addrspace(67) readonly %[[A:[^,]+]],
# CHECK-SAME: ptr addrspace(67) readonly %[[B:[^,]+]],
# CHECK-SAME: i64 noundef {{.*}}%[[N:[^,]+]])
# CHECK: br {{.+}}, label %[[END:.+]], label %[[BODY:.+]]
# CHECK: [[BODY]]:
# CHECK: %[[I:.+]] = phi i64
# CHECK: %[[IDXA:.+]] = tail call {{.*}}(ptr {{.*}}%[[A]], i64 {{.*}}%[[I]])
# CHECK: %[[VA:.+]] = load double, ptr %[[IDXA]]
# CHECK: %[[IDXB:.+]] = tail call {{.*}}(ptr {{.*}}%[[B]], i64 {{.*}}%[[I]])
# CHECK: %[[VB:.+]] = load double, ptr %[[IDXB]]
# CHECK: %[[ADD:.+]] = fadd double %[[VA]], %[[VB]]
# CHECK: %[[IDXC:.+]] = tail call {{.*}}(ptr {{.*}}%[[C]], i64 {{.*}}%[[I]])
# CHECK: store double %[[ADD]], ptr %[[IDXC]]
# CHECK: %[[INC:.+]] = add {{.+}} %[[I]], 1
# CHECK: %[[CMP:.+]] = icmp
# CHECK: br i1 %[[CMP]], label %[[END]], label %[[BODY]], !llvm.loop
# CHECK: [[END:.+]]:
# CHECK: ret void
