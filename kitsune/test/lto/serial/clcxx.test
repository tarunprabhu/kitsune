# Check that the command line options common to all tapir targets are handled
# correctly when -flto is provided. The serial tapir target is always built
# and handles all the common options.
#
# RUN: %kitxx -### -ftapir=serial -O2 -flto \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp 2>&1 \
# RUN:     | FileCheck %s -check-prefixes=ALL
#
# RUN: %kitxx -### -ftapir=serial -O2 -flto --tapir-verbose \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp 2>&1 \
# RUN:     | FileCheck %s -check-prefixes=ALL,TAPIR_VERBOSE
#
# RUN: %kitxx -### -ftapir=serial -O2 -flto --kitrt-verbose \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp 2>&1 \
# RUN:     | FileCheck %s -check-prefixes=ALL,KITRT_VERBOSE
#
# RUN: %kitxx -### -ftapir=serial -O2 -flto -ffp-contract=off  \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp 2>&1 \
# RUN:     | FileCheck %s -check-prefixes=ALL,FP_STANDARD
#
# RUN: %kitxx -### -ftapir=serial -O2 -flto -ffp-contract=on  \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp 2>&1 \
# RUN:     | FileCheck %s -check-prefixes=ALL,FP_STANDARD
#
# RUN: %kitxx -### -ftapir=serial -O2 -flto -ffp-contract=fast  \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp 2>&1 \
# RUN:     | FileCheck %s -check-prefixes=ALL,FP_FAST
#
# RUN: %kitxx -### -ftapir=serial -O2 -flto -ffp-contract=fast-honor-pragmas \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp 2>&1 \
# RUN:     | FileCheck %s -check-prefixes=ALL,FP_STANDARD
#
# ALL: /ld{{(64)?}}.lld"
# ALL-SAME: "-mllvm" "--tapir=serial"
# TAPIR_VERBOSE-SAME: "-mllvm" "--tapir-verbose"
# KITRT_VERBOSE: "-mllvm" "--kitrt-verbose"
# FP_STANDARD: "-mllvm" "--fp-contract=on"
# FP_FAST: "-mllvm" "--fp-contract=fast"
