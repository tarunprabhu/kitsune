# Check that the tapir lowering passes are not run when compiling to an "object
# file" (the prelink phase). When performing the actual link, the lowering
# passes should be run.
#
# RUN: mkdir -p %t
#
# RUN: %kitxx -c -flto --tapir=serial -O2 --tapir-verbose %S/../input/add.cpp \
# RUN:     -o %t/add.o -fno-stripmine 2>&1 \
# RUN:     | FileCheck %s --check-prefixes=NO-LOWER --allow-empty
#
# RUN: %kitxx -c -flto --tapir=serial -O2 --tapir-verbose %S/../input/main.cpp \
# RUN:     -o %t/main.o -fno-stripmine 2>&1 \
# RUN:     | FileCheck %s --check-prefixes=NO-LOWER --allow-empty
#
# RUN: %kitxx -flto -O3 %t/main.o %t/add.o -o %t/a.bc %sysroot \
# RUN:     -fno-stripmine -Wl,--lto-emit-llvm \
# RUN:     --tapir=serial --tapir-verbose 2>&1 \
# RUN:     | FileCheck %s --check-prefixes=LOWER
#
# NO-LOWER-NOT: 'serial' tapir target options
# LOWER: 'serial' tapir target options
# LOWER: Optimization level: O3
