# Check a "standard" lowering using LTO, but where each file is compiled
# separately.
#
# RUN: mkdir -p %t
#
# RUN: %kitxx -c -flto --tapir=serial -O2 %sysroot -fno-inline -fno-stripmine \
# RUN:     -o %t/add.o  %S/../input/add.cpp
#
# RUN: %kitxx -c -flto --tapir=serial -O2 %sysroot -fno-inline -fno-stripmine \
# RUN:     -o %t/main.o %S/../input/main.cpp \
# RUN:     -fno-stripmine
#
# RUN: %kitxx -flto --tapir=serial -fno-inline -fno-stripmine -O2 %sysroot \
# RUN:     -Wl,--lto-emit-llvm \
# RUN:     %t/main.o %t/add.o -o %t/a.bc
#
# RUN: llvm-dis -o - %t/add.o | FileCheck %s --check-prefix TAPIR
# RUN: llvm-dis -o - %t/main.o | FileCheck %s --check-prefix MAIN
# RUN: llvm-dis -o - %t/a.bc | FileCheck %s --check-prefix LOWERED
#
# TAPIR: detach within
# TAPIR: reattach within
# TAPIR: sync within
#
# MAIN: call void @_Z6vecadd
#
# LOWERED: define {{.*}}void @_Z6vecadd{{[^(]+}}(
# LOWERED-SAME: {{[^%]*}}%[[C:[^,]+]],
# LOWERED-SAME: {{[^%]*}}%[[A:[^,]+]],
# LOWERED-SAME: {{[^%]*}}%[[B:[^,]+]],
# LOWERED-SAME: i64 {{[^%]*}}%[[N:[^,]+]])
# LOWERED: br {{.+}}, label %[[END:.+]], label %[[BODY:[^,]+]]
# LOWERED: [[BODY]]:
# LOWERED: %[[I:.+]] = phi i64
# LOWERED: %[[IDXA:.+]] = tail call {{.*}}(ptr {{.*}}, i64 {{.*}}%[[I]])
# LOWERED: %[[VA:.+]] = load double, ptr %[[IDXA]]
# LOWERED: %[[IDXB:.+]] = tail call {{.*}}(ptr {{.*}}, i64 {{.*}}%[[I]])
# LOWERED: %[[VB:.+]] = load double, ptr %[[IDXB]]
# LOWERED: %[[ADD:.+]] = fadd double %[[VA]], %[[VB]]
# LOWERED: %[[IDXC:.+]] = tail call {{.*}}(ptr {{.*}}, i64 {{.*}}%[[I]])
# LOWERED: store double %[[ADD]], ptr %[[IDXC]]
# LOWERED: %[[INC:.+]] = add {{.+}} %[[I]], 1
# LOWERED: %[[CMP:.+]] = icmp
# LOWERED: br i1 %[[CMP]], label %[[END]], label %[[BODY]], !llvm.loop
# LOWERED: [[END:.+]]:
# LOWERED: ret void
