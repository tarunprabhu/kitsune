# Check a "standard" lowering using LTO, but where each file is compiled
# separately. We check the output of the loop spawning pass rather than the
# final result which will include the effect of some cleanup passes run after
# loop spawning. This is intentionally very basic because -fno-vectorize and
# -fno-unroll-loops are not fully respected when using LTO. We simply check that
# there are no Kitsune intrinsics in the lowered code.
#
# RUN: mkdir -p %t
#
# RUN: %kitxx -c -flto --tapir=serial -O2 %sysroot \
# RUN:     -fno-inline -fno-vectorize -fno-unroll-loops \
# RUN:     -o %t/add.o  %S/../input/add.cpp
# RUN: llvm-dis -o - %t/add.o | FileCheck %s --check-prefix TAPIR
#
# TAPIR: detach within
# TAPIR: reattach within
# TAPIR: sync within
#
#
# RUN: %kitxx -c -flto --tapir=serial -O2 %sysroot \
# RUN:     -fno-inline -fno-vectorize -fno-unroll-loops \
# RUN:     -o %t/main.o %S/../input/main.cpp
# RUN: llvm-dis -o - %t/main.o | FileCheck %s --check-prefix MAIN
#
# MAIN: call void @vecadd
#
#
# RUN: %kitxx -flto --tapir=serial -fno-inline -O2 %sysroot \
# RUN:     -Wl,--lto-emit-llvm \
# RUN:     %t/main.o %t/add.o -o - \
# RUN:     | llvm-dis -o - \
# RUN:     | FileCheck %s --check-prefix LOWERED
#
# LOWERED: define {{.*}}void @vecadd(
# LOWERED-SAME: {{[^%]*}}%[[C:[^,]+]],
# LOWERED-SAME: {{[^%]*}}%[[A:[^,]+]],
# LOWERED-SAME: {{[^%]*}}%[[B:[^,]+]],
# LOWERED-SAME: i64 {{[^%]*}}%[[N:[^,]+]])
# LOWERED-NOT: @llvm.kit.
# LOWERED: ret void
