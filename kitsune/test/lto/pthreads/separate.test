# Check a "standard" lowering using LTO, but where each file is compiled
# separately.
#
# RUN: mkdir -p %t
#
# RUN: %kitxx -flto --tapir=pthreads -fno-inline -fno-stripmine -O2 %sysroot \
# RUN:     -c -o %t/add.o  %S/../input/add.cpp
#
# RUN: %kitxx -flto --tapir=pthreads -fno-inline -fno-stripmine -O2 %sysroot \
# RUN:     -c -o %t/main.o %S/../input/main.cpp \
# RUN:     -fno-stripmine
#
# RUN: %kitxx -flto --tapir=pthreads -fno-inline -fno-stripmine -O2 %sysroot \
# RUN:     -Wl,--lto-emit-llvm \
# RUN:     %t/main.o %t/add.o -o %t/a.bc
#
# RUN: llvm-dis -o - %t/add.o | FileCheck %s --check-prefix TAPIR
# RUN: llvm-dis -o - %t/main.o | FileCheck %s --check-prefix MAIN
# RUN: llvm-dis -o - %t/a.bc | FileCheck %s --check-prefix LOWERED
#
# TAPIR: detach within
# TAPIR: reattach within
# TAPIR: sync within
#
# MAIN: call void @_Z6vecadd
#
# LOWERED: define {{.*}}void @_Z6vecadd{{[^(]+}}(
# LOWERED-SAME: {{[^%]*}}%[[C:[^,]+]],
# LOWERED-SAME: {{[^%]*}}%[[A:[^,]+]],
# LOWERED-SAME: {{[^%]*}}%[[B:[^,]+]],
# LOWERED-SAME: i64 {{[^%]*}}%[[N:[^,]+]])
# LOWERED: %[[PACK:.+]] = alloca
# LOWERED-SAME: i64
# LOWERED-SAME: i64
# LOWERED-SAME: ptr addrspace(67)
# LOWERED-SAME: ptr addrspace(67)
# LOWERED-SAME: ptr addrspace(67)
# LOWERED-SAME: {{[}]}}
# LOWERED: %[[THRDS32:.+]] = {{.*}}call i32 @llvm.kit.cpu.num.threads(i32 1024)
# LOWERED: %[[NUM_THREADS:.+]] = sext i32 %[[THRDS32]] to i64
# LOWERED: %[[PER_THREAD:.+]] = udiv i64 {{.+}}, %[[NUM_THREADS]]
# LOWERED: %[[CTX:.+]] = call ptr @llvm.kit.async.cpu.threads.launch(
# LOWERED-SANE: i32 1024,
# LOWERED-SAME: ptr @[[OUTLINED:_Z6vecadd[^,]+]],
# LOWERED-SAME: i64 0,
# LOWERED-SAME: i64 %[[NUM_THREADS]],
# LOWERED-SAME: i64 0,
# LOWERED-SAME: ptr %[[PACK]])
# LOWERED: call void @llvm.kit.cpu.threads.sync(i32 1024, ptr %[[CTX]])
# LOWERED: ret void
#
# LOWERED: define internal fastcc void @[[OUTLINED]](
# LOWERED-SAME: i64 %[[START:[^,]+]],
# LOWERED-SAME: i64 %[[END:[^,]+]],
# LOWERED-SAME: i64 %[[GRAINSIZE:[^,]+]],
# LOWERED-SAME: ptr {{.*}}%[[ARGS:[^)]+]])
# LOWERED: %[[ARGN:.+]] = getelementptr i8, ptr %[[ARGS]], i64 8
# LOWERED: %[[ARGA:.+]] = getelementptr i8, ptr %[[ARGS]], i64 16
# LOWERED: %[[ARGB:.+]] = getelementptr i8, ptr %[[ARGS]], i64 24
# LOWERED: %[[ARGC:.+]] = getelementptr i8, ptr %[[ARGS]], i64 32
# LOWERED: br label %[[BODY:.+]]
# LOWERED: [[BODY:.+]]:
# LOWERED: %[[I:.+]] = phi i64
# LOWERED: %[[PERTHRD:.+]] = load i64, ptr %[[ARGS]]
# LOWERED: %[[N:.+]] = load i64, ptr %[[ARGN]]
# LOWERED: %[[PTRA:.+]] = load ptr addrspace(67), ptr %[[ARGA]]
# LOWERED: %[[PTRB:.+]] = load ptr addrspace(67), ptr %[[ARGB]]
# LOWERED: %[[PTRC:.+]] = load ptr addrspace(67), ptr %[[ARGC]]
# LOWERED: %[[IDXA:.+]] = {{.*}}call {{.+}} ptr @
# LOWERED: %[[VA:.+]] = load double, ptr %[[IDXA]]
# LOWERED: %[[IDXB:.+]] = {{.*}}call {{.+}} ptr @
# LOWERED: %[[VB:.+]] = load double, ptr %[[IDXB]]
# LOWERED: %[[SUM:.+]] = fadd double %[[VA]], %[[VB]]
# LOWERED: %[[IDXC:.+]] = {{.*}}call
# LOWERED: store double %[[SUM]], ptr %[[IDXC]]
# LOWERED: add {{.*}}i64 %[[I]], 1
# LOWERED: %[[ICMP:.+]] = icmp
# LOWERED: br i1 %[[ICMP]], label %[[EXIT:.+]], label %[[BODY]]
# LOWERED: [[EXIT]]:
# LOWERED: ret void
