# REQUIRES: !system-darwin
#
# FIXME: ld64.lld does not support --lto-emit-llvm. We may implement this at
# some point. Until then, disable this test there.
#
# ------------------------------------------------------------------------------
# Check a standard lowering using LTO.
#
# RUN: %kitxx --tapir=pthreads -O2 -flto -fno-inline -o - %sysroot \
# RUN:     -Wl,--lto-emit-llvm \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp \
# RUN:     | llvm-dis -o - \
# RUN:     | FileCheck %s
#
# CHECK: define {{.*}}void @_Z6vecadd{{[^(]+}}(
# CHECK-SAME: ptr addrspace(67) writeonly %[[C:[^,]+]],
# CHECK-SAME: ptr addrspace(67) readonly %[[A:[^,]+]],
# CHECK-SAME: ptr addrspace(67) readonly %[[B:[^,]+]],
# CHECK-SAME: i64 {{.*}}%[[N:[^,]+]])
# CHECK: %[[PACK:.+]] = alloca
# CHECK: store ptr addrspace(67) %[[A]], ptr %[[PACK]]
# CHECK: %[[PACK1:.+]] = getelementptr {{.*}}i8, ptr %[[PACK]]
# CHECK: store ptr addrspace(67) %[[B]], ptr %[[PACK1]]
# CHECK: %[[PACK2:.+]] = getelementptr {{.*}}i8, ptr %[[PACK]]
# CHECK: store ptr addrspace(67) %[[C]], ptr %[[PACK2]]
# CHECK: %[[CTX:.+]] = call ptr @llvm.kit.async.launch.threads(
# CHECK-SANE: i32 1024,
# CHECK-SAME: ptr @[[OUTLINED:_Z6vecadd[^,]+]],
# CHECK-SAME: i64 0,
# CHECK-SAME: i64 %[[N]],
# CHECK-SAME: i64 0,
# CHECK-SAME: ptr %[[PACK]])
# CHECK: call void @llvm.kit.sync.threads(i32 1024, ptr %[[CTX]])
# CHECK: ret void
#
# CHECK: define internal fastcc void @[[OUTLINED]](
# CHECK-SAME: i64 %[[START:[^,]+]],
# CHECK-SAME: i64 %[[END:[^,]+]],
# CHECK-SAME: i64 %[[GRAINSIZE:[^,]+]],
# CHECK-SAME: ptr {{.*}}%[[ARGS:[^)]+]])
# CHECK: %[[ARGB:.+]] = getelementptr i8, ptr %[[ARGS]], i64 8
# CHECK: %[[ARGC:.+]] = getelementptr i8, ptr %[[ARGS]], i64 16
# CHECK: br label %[[BODY:.+]]
# CHECK: [[BODY:.+]]:
# CHECK: %[[I:.+]] = phi i64
# CHECK: %[[PTRA:.+]] = load ptr addrspace(67), ptr %[[ARGS]]
# CHECK: %[[PTRB:.+]] = load ptr addrspace(67), ptr %[[ARGB]]
# CHECK: %[[PTRC:.+]] = load ptr addrspace(67), ptr %[[ARGC]]
# CHECK: %[[IDXA:.+]] = {{.*}}call
# CHECK: %[[VA:.+]] = load double, ptr %[[IDXA]]
# CHECK: %[[IDXB:.+]] = {{.*}}call
# CHECK: %[[VB:.+]] = load double, ptr %[[IDXB]]
# CHECK: %[[SUM:.+]] = fadd double %[[VA]], %[[VB]]
# CHECK: %[[IDXC:.+]] = {{.*}}call
# CHECK: store double %[[SUM]], ptr %[[IDXC]]
# CHECK: add {{.*}}i64 %[[I]], 1
# CHECK: %[[ICMP:.+]] = icmp
# CHECK: br i1 %[[ICMP]], label %[[EXIT:.+]], label %[[BODY]]
# CHECK: [[EXIT]]:
# CHECK: ret void
