# Check a standard lowering using LTO.
#
# RUN: %kitxx --tapir=pthreads -O2 -flto -fno-inline -o - %sysroot \
# RUN:     -Wl,--lto-emit-llvm \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp \
# RUN:     | llvm-dis -o - \
# RUN:     | FileCheck %s
#
# CHECK: define {{.*}}void @_Z6vecadd{{[^(]+}}(
# CHECK-SAME: ptr {{[^%]*}}%[[C:[^,]+]],
# CHECK-SAME: ptr {{[^%]*}}%[[A:[^,]+]],
# CHECK-SAME: ptr {{[^%]*}}%[[B:[^,]+]],
# CHECK-SAME: i64 {{[^%]*}}%[[N:[^,]+]])
# CHECK: %[[PACK:.+]] = alloca {{[{]}}
# CHECK-SAME: i64
# CHECK-SAME: i64
# CHECK-SAME: ptr addrspace(67)
# CHECK-SAME: ptr addrspace(67)
# CHECK-SAME: ptr addrspace(67)
# CHECK-SAME: {{[}]}}
# CHECK: %[[THRDS32:.+]] = {{.*}}call i32 @llvm.kit.cpu.num.threads(i32 1024)
# CHECK: %[[NUM_THREADS:.+]] = sext i32 %[[THRDS32]] to i64
# CHECK: %[[PER_THREAD:.+]] = udiv i64 {{.+}}, %[[NUM_THREADS]]
# CHECK: %[[CTX:.+]] = call ptr @llvm.kit.async.cpu.threads.launch(
# CHECK-SANE: i32 1024,
# CHECK-SAME: ptr @[[OUTLINED:_Z6vecadd[^,]+]],
# CHECK-SAME: i64 0,
# CHECK-SAME: i64 %[[NUM_THREADS]],
# CHECK-SAME: ptr %[[PACK]])
# CHECK: call void @llvm.kit.cpu.threads.sync(i32 1024, ptr %[[CTX]])
# CHECK: ret void
#
# CHECK: define internal fastcc void @[[OUTLINED]](
# CHECK-SAME: i64 %[[START:[^,]+]],
# CHECK-SAME: i64 %[[END:[^,]+]],
# CHECK-SAME: ptr {{.*}}%[[ARGS:[^)]+]])
# CHECK: %[[ARGN:.+]] = getelementptr i8, ptr %[[ARGS]], i64 8
# CHECK: %[[ARGA:.+]] = getelementptr i8, ptr %[[ARGS]], i64 16
# CHECK: %[[ARGB:.+]] = getelementptr i8, ptr %[[ARGS]], i64 24
# CHECK: %[[ARGC:.+]] = getelementptr i8, ptr %[[ARGS]], i64 32
# CHECK: br label %[[BODY:.+]]
# CHECK: [[BODY:.+]]:
# CHECK: %[[I:.+]] = phi i64
# CHECK: %[[PERTHRD:.+]] = load i64, ptr %[[ARGS]]
# CHECK: %[[N:.+]] = load i64, ptr %[[ARGN]]
# CHECK: %[[PTRA:.+]] = load ptr addrspace(67), ptr %[[ARGA]]
# CHECK: %[[PTRB:.+]] = load ptr addrspace(67), ptr %[[ARGB]]
# CHECK: %[[PTRC:.+]] = load ptr addrspace(67), ptr %[[ARGC]]
# CHECK: %[[IDXA:.+]] = {{.*}}call {{.+}} ptr @
# CHECK: %[[VA:.+]] = load double, ptr %[[IDXA]]
# CHECK: %[[IDXB:.+]] = {{.*}}call {{.+}} ptr @
# CHECK: %[[VB:.+]] = load double, ptr %[[IDXB]]
# CHECK: %[[SUM:.+]] = fadd double %[[VA]], %[[VB]]
# CHECK: %[[IDXC:.+]] = {{.*}}call
# CHECK: store double %[[SUM]], ptr %[[IDXC]]
# CHECK: add {{.*}}i64 %[[I]], 1
# CHECK: %[[ICMP:.+]] = icmp
# CHECK: br i1 %[[ICMP]], label %[[EXIT:.+]], label %[[BODY]]
# CHECK: [[EXIT]]:
# CHECK: ret void
