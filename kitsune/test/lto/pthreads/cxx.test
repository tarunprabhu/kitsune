# Check a standard lowering using LTO. We don't check as carefully as well do
# for the non-LTO lowering because simply passing -fno-vectorize and
# -fno-unroll-loops does not work as expected when using LTO.
#
# RUN: %kitxx --tapir=pthreads -O2 -flto -o /dev/null %sysroot \
# RUN:     -fno-inline -fno-vectorize -fno-unroll-loops \
# RUN:     -Wl,--lto-emit-llvm \
# RUN:     -Wl,-mllvm -Wl,-print-after=loop-spawning \
# RUN:     %S/../input/add.cpp %S/../input/main.cpp 2>&1 \
# RUN:     | FileCheck %s
#
# CHECK: define internal fastcc void @vecadd(
# CHECK-SAME: ptr {{[^%]*}}%[[C:[^,]+]],
# CHECK-SAME: ptr {{[^%]*}}%[[A:[^,]+]],
# CHECK-SAME: ptr {{[^%]*}}%[[B:[^,]+]],
# CHECK-SAME: i64 {{[^%]*}}%[[N:[^,]+]])
# CHECK: %[[SYSTHRDS:.+]] = tail call i64 @llvm.kit.cpu.num.threads(i32 1024)
# CHECK: %[[CTX:.+]] = tail call ptr @__kitrt_nest_begin(i64 %[[SYSTHRDS]], i32 1)
# CHECK: %[[THREADS:.+]] = tail call i64 @__kitrt_nest_threads(ptr %[[CTX]])
# CHECK: %[[LAUNCHCTX:.+]] = call {{.+}} @llvm.kit.async.cpu.threads.launch(
# CHECK-SAME: i32 1024,
# CHECK-SAME: ptr @[[WRAPPER:[^,]+]],
# CHECK-SAME: i64 0,
# CHECK-SAME: i64 %[[THREADS]],
# CHECK-SAME: ptr %[[CTX]],
# CHECK-SAME: i64 %[[N]],
# CHECK-SAME: ptr %[[A]],
# CHECK-SAME: ptr %[[B]],
# CHECK-SAME: ptr %[[C]],
# CHECK-NEXT: call void @llvm.kit.cpu.threads.sync(i32 1024, ptr %[[LAUNCHCTX]])
# CHECK: ret void
#
# CHECK: define internal fastcc void @[[WRAPPER]](
# CHECK-SAME: i64 {{[^%]*}}%[[BEG:[^,]+]],
# CHECK-SAME: ptr {{[^%]*}}%[[ARGS:[^)]+]])
