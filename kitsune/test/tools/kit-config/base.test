# -----------------------------------------------------------------------------
#
# Some basic tests for the kit-config utility.
#
# RUN: %kitconf --known-langs | FileCheck %s -check-prefix KNOWN-LANGS
# RUN: %kitconf --known-tapir-targets | FileCheck %s -check-prefix KNOWN-TARGETS
#
# KNOWN-LANGS: C C++ Fortran
# KNOWN-TARGETS: cuda hip lambda omptask opencilk openmp qthreads realm serial
#
# -----------------------------------------------------------------------------
#
# We can't really do a "proper" version check, so just check that it is
# something reasonable. This effectively only checks that the command line
# option is handled.
#
# RUN: %kitconf --kitsune-version | FileCheck %s -check-prefix VERSION
# RUN: %kitconf --llvm-version | FileCheck %s -check-prefix VERSION
# RUN: %kitconf --version | FileCheck %s --check-prefix VERSION
#
# VERSION: {{[0-9]+}}.{{[0-9]+}}.{{[0-9]+}}{{.*}}
#
# -----------------------------------------------------------------------------
#
# Passing --help should return success and print something. An unknown option
# should return failure and print the help message. At least one option is
# required.
#
# RUN: %kitconf --help 2>&1 | FileCheck %s -check-prefix HELP
# RUN: not %kitconf --bogus 2>&1 | FileCheck %s -check-prefix HELP
# RUN: not %kitconf 2>&1 | FileCheck %s -check-prefix HELP
#
# HELP: usage: kit-config <OPTION>
#
# -----------------------------------------------------------------------------
#
# The C and C++ frontends are always enabled.
#
# RUN: %kitconf --langs | FileCheck %s -check-prefix LANGS
# RUN: %kitconf --c | FileCheck %s -check-prefix ON
# RUN: %kitconf --c-frontend | FileCheck %s --check-prefix KITCC
# RUN: %kitconf --cxx | FileCheck %s --check-prefix ON
# RUN: %kitconf --cxx-frontend | FileCheck %s --check-prefix KITXX
#
# LANGS: C C++
# ON: ON
# KITCC: {{.+}}/kitcc
# KITXX: {{.+}}/kit++
#
# -----------------------------------------------------------------------------
#
# Check that when certain frontends and tapir targets are disabled, the correct
# correct value is reported.
#
# RUN: %if kitsune-no-kokkos %{ \
# RUN:   %kitconf --kokkos | FileCheck %s -check-prefix OFF \
# RUN: %}
#
# RUN: %if kitsune-no-cuda %{ \
# RUN:   %kitconf --cuda-target | FileCheck %s -check-prefix OFF \
# RUN: %}
#
# RUN: %if kitsune-no-hip %{ \
# RUN:   %kitconf --hip-target | FileCheck %s -check-prefix OFF \
# RUN: %}
#
# RUN: %if kitsune-no-lambda %{ \
# RUN:   %kitconf --lambda-target | FileCheck %s -check-prefix OFF \
# RUN: %}
#
# RUN: %if kitsune-no-omptask %{ \
# RUN:   %kitconf --omptask-target | FileCheck %s -check-prefix OFF \
# RUN: %}
#
# RUN: %if kitsune-no-opencilk %{ \
# RUN:   %kitconf --opencilk-target | FileCheck %s -check-prefix OFF \
# RUN: %}
#
# RUN: %if kitsune-no-openmp %{ \
# RUN:   %kitconf --openmp-target | FileCheck %s -check-prefix OFF \
# RUN: %}
#
# RUN: %if kitsune-no-qthreads %{ \
# RUN:   %kitconf --qthreads-target | FileCheck %s -check-prefix OFF \
# RUN: %}
#
# RUN: %if kitsune-no-realm %{ \
# RUN:   %kitconf --realm-target | FileCheck %s -check-prefix OFF \
# RUN: %}
#
# OFF: OFF
#
# -----------------------------------------------------------------------------
