# Check basic usage and command line options
#
# ------------------------------------------------------------------------------
#
# RUN: echo "" | %kitmenc \
# RUN:     | FileCheck %s --check-prefix=DEFAULT
#
# DEFAULT: @{{.+}} = unnamed_addr constant {{.+}} #[[CUDA:[0-9]+]]
# DEFAULT: #[[CUDA]] = { kit_bc(2) }
#
# ------------------------------------------------------------------------------
#
# RUN: echo "" | %kitmenc -tapir=serial \
# RUN:     | FileCheck %s --check-prefix=SERIAL
#
# SERIAL: @{{.+}} = unnamed_addr constant {{.+}} #[[SERIAL:[0-9]+]]
# SERIAL: #[[SERIAL]] = { kit_bc(1) }
#
# ------------------------------------------------------------------------------
#
# RUN: %kitmenc -tapir=hip %S/input/empty.ll \
# RUN:     | FileCheck %s --check-prefix=HIP
#
# HIP: @{{.+}} = unnamed_addr constant {{.+}} #[[HIP:[0-9]+]]
# HIP: #[[HIP]] = { kit_bc(4) }
#
# ------------------------------------------------------------------------------
