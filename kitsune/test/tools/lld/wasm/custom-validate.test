# Check that the values of the command line options used by the custom tapir
# target are validated when passed to lld.
#
# RUN: not %lld -mllvm --tapir=custom -mllvm --tapir-plugin= \
# RUN:         -m wasm64 --no-entry -o /dev/null %S/input/empty.o 2>&1 \
# RUN:     | FileCheck %s --check-prefix=MISSING
#
# MISSING: error: for the --tapir-plugin option: value '' is invalid
#
# RUN: not %lld -mllvm --tapir=custom -mllvm --tapir-plugin=noexist \
# RUN:         -m wasm64 --no-entry -o /dev/null %S/input/empty.o 2>&1 \
# RUN:     | FileCheck %s --check-prefix=NOEXIST
#
# The actual error message for a non-existent file is system-dependent. While
# it would be nice if we could check that the correct error message is shown
# in such cases, it is probably not worth the extra effort.
#
# NOEXIST: error: Could not load library
#
# RUN: not %lld -mllvm --tapir=custom -mllvm --tapir-plugin=%s \
# RUN:         -m wasm64 --no-entry -o /dev/null %S/input/empty.o 2>&1 \
# RUN:     | FileCheck %s --check-prefix=CONTENTS
#
# CONTENTS: error: Could not load library
