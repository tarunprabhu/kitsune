# REQUIRES: kitsune-cuda && kitsune-hip
#
# Test some basic functionality of kit-mdc when operating on object files with
# embedded device code generated by more than one tapir target.
#
# RUN: rm -rf %t
# RUN: mkdir %t
# RUN: mkdir %t/in %t/wd %t/out
#
# Create the object files to be used for testing. Do this on the fly to avoid
# adding binary blobs to the repo.
#
# RUN: llc -o %t/in/cdc.o -filetype=obj %S/input/cuda-mbc.ll \
# RUN:     --tapir=cuda --tapir-cuda-arch=sm_72
#
# RUN: llc -o %t/in/hdc.o -filetype=obj %S/input/hip-mbc.ll \
# RUN:     --tapir=hip --tapir-hip-arch=gfx1103
#
# RUN: llc -o %t/in/multidc.o -filetype=obj %S/input/multi-mbc.ll \
# RUN:     --tapir=cuda --tapir-cuda-arch=sm_75 --tapir-hip-arch=gfx904
#
# ------------------------------------------------------------------------------
# If neither an output file, nor an output directory have been specified,
# extract the embedded device code into the current directory. The names of the
# extracted files are derived from the device architecture and binary format.
#
# RUN: cd %t/wd
# RUN: rm -rf %t/wd/*.cubin %t/wd/*.o
#
# RUN: kit-mdc %t/in/multidc.o
# RUN: ls %t/wd/multidc-sm_75.cubin
# RUN: ls %t/wd/multidc-gfx904.o
#
# ------------------------------------------------------------------------------
# If an output directory has been given, ensure that the extracted files are
# written to that directory.
#
# RUN: rm -rf %t/out/*
#
# RUN: kit-mdc -J %t/out %t/in/multidc.o
# RUN: ls %t/out/multidc-sm_75.cubin
# RUN: ls %t/out/multidc-gfx904.o
#
# ------------------------------------------------------------------------------
# Check that the --tapir option works as expected.
#
# RUN: cd %t/wd
# RUN: rm -rf %t/wd/*.*
#
# RUN: kit-mdc --tapir=cuda -o %t/wd/amdgpu.o %t/in/hdc.o
# RUN: not ls *
#
# RUN: kit-mdc --tapir=hip -o %t/wd/nv.cubin %t/in/cdc.o
# RUN: not ls *
#
# RUN: rm -rf %t/wd/*.*
# RUN: kit-mdc --tapir=cuda %t/in/multidc.o
# RUN: ls *sm*.cubin
# RUN: not ls *gfx*.o
#
# RUN: rm -rf %t/wd/*.*
# RUN: kit-mdc --tapir=hip %t/in/multidc.o
# RUN: not ls *sm*.cubin
# RUN: ls *gfx*.o
