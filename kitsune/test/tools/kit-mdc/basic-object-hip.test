# REQUIRES: kitsune-hip
#
# Test some basic functionality of kit-mdc when operating on object files
# containing embedded device code generated by the hip tapir target.
#
# Create temporary working directories
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: rm -rf %t/in && mkdir -p %t/in
# RUN: rm -rf %t/wd && mkdir -p %t/wd
# RUN: rm -rf %t/out && mkdir -p %t/out
#
# Create the object files to be used for testing. The sources are checked in
# to avoid having binary blobs checked in.
#
# RUN: llc -o %t/in/hdc.o -filetype=obj %S/input/hip-mbc.ll \
# RUN:     --tapir=hip --tapir-hip-arch=gfx1103 
#
# ------------------------------------------------------------------------------
# If an explicit output file has been given, the extracted device code must be
# written to it.
#
# RUN: rm -rf %t/amdgpu.o
#
# RUN: not cat %t/amdgpu.o
# RUN: kit-mdc -o %t/amdgpu.o %t/in/hdc.o
# RUN: cat %t/amdgpu.o
#
# ------------------------------------------------------------------------------
# If neither an output file, nor an output directory have been specified,
# extract the embedded device code into the current directory. The names of the
# extracted files are derived from the device architecture and binary format.
#
# RUN: cd %t/wd
# run: rm -rf %t/wd/*.o
#
# RUN: kit-mdc %t/in/hdc.o
# RUN: cat %t/wd/hdc-gfx1103.o
#
# ------------------------------------------------------------------------------
# If an output directory has been given, ensure that the extracted files are
# written to that directory.
#
# RUN: rm -rf %t/out/*
#
# RUN: kit-mdc -J %t/out %t/in/hdc.o
# RUN: cat %t/out/hdc-gfx1103.o
