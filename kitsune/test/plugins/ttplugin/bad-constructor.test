# Check that an appropriate error is emitted when loading a tapir target plugin
# that does not contain a tapir target constructor.
#
# RUN: rm -rf %t
# RUN: mkdir %t
#
# RUN: %kitxx -I%kit_inc_dir -I%llvm_obj_inc_dir -I%llvm_src_inc_dir %sysroot \
# RUN:     -fPIC -shared -o %t/bad-constructor.so \
# RUN:     %S/input/bad-constructor.cpp
#
# RUN: not %kitcc --tapir=custom --tapir-plugin=%t/bad-constructor.so \
# RUN:     -S -emit-llvm -O1 -o /dev/null %S/input/empty.c 2>&1 \
# RUN:     | FileCheck %s
#
# RUN: not %kitxx --tapir=custom --tapir-plugin=%t/bad-constructor.so \
# RUN:     -S -emit-llvm -O1 -o /dev/null %S/input/empty.cpp 2>&1 \
# RUN:     | FileCheck %s
#
# RUN: %if kitfc %{\
# RUN:     not %kitfc --tapir=custom --tapir-plugin=%t/bad-constructor.so \
# RUN:     -S -emit-llvm -O1 -o /dev/null %S/input/empty.f90 2>&1 \
# RUN:     | FileCheck %s \
# RUN: %}
#
# RUN: not opt --tapir=custom --tapir-plugin=%t/bad-constructor.so \
# RUN:     -passes='kit-lowering<O1>' %S/input/empty.ll 2>&1 \
# RUN:     | FileCheck %s
#
# CHECK: Missing constructor callback in plugin
