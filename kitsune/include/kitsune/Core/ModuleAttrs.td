//===----------------------------------------------------------------------===//
//
// Module-level "attributes". These are really named metadata nodes in a module.
//
//===----------------------------------------------------------------------===//

// Base class for the type of a value. The Name field must be spelled exactly as
// the corresponding type. The type must be either a builtin type, or must be
// defined in the llvm namespace. For instance, int32_t, StringRef or TTID
// (defined in kitsune/Core/Tapir.h). Types with explicit bitwidths are strongly
// preferred over `int`, `long` etc.
class ValueType<string NameParam> {
  string Name = NameParam;
}

def TTID : ValueType<"TTID">;
def Int32 : ValueType<"int32_t">;
def Int64 : ValueType<"int64_t">;
def StringRef : ValueType<"StringRef">;

// A pair of a type name and field name for the value of an attribute. The
// name must be a value C identifier.
class Value<ValueType TypeParam, string NameParam> {
  ValueType Type = TypeParam;
  string Name = NameParam;
}

// Base class for Kitsune-specific module attributes.
//
// The names of the concrete instances of this class will be the name of the
// attribute as it appears in the ModuleAttrKind enum. This must be in Pascal
// case, and consist of letters and digits only. The name of the attribute as it
// appears in LLVM-IR metadata is derived from this. The table below shows
// some examples of this.
//
//     .--------------------------------------------------.
//     | Name           | Metadata string                 |
//     |--------------------------------------------------|
//     | Device         | kit.module.loop.device          |
//     | LoopsAnnotated | kit.module.loop.loops.annotated |
//     | Bytesize       | kit.module.loop.bytesize        |
//     | Version4       | kit.module.loop.version4        |
//     '--------------------------------------------------'
//
// The attributes may have values associated with them. In most cases, a number
// of accessor functions will be generated for each attribute declared here.
// These are generally of the form
//
//     bool has<NAME>Attr(const Module &m);
//     NamedMDNode& add<NAME>Attr(Module &m, ...);
//     void remove<Name>Attr(Module &m);
//
// Here <NAME> is the name of the concrete instance of the attribute that has
// been defined here. The add<NAME>attr function will accept 0 or more
// arguments depending on the number of values that the attribute has. For a
// "flag" attribute that does not accept a value, the signature will be:
//
//     NamedMDNode& add<NAME>Attr(Module &m);
//
// while for one that accepts a TTID enum and a string, it will be:
//
//     NamedMDNode& add<NAME>Attr(Module &m, TTID tt, StringRef s);
//
class Attr<list<Value> ValuesParam> {
  // The possibly empty list of types for each value that the attribute expects.
  // Note that this is not like a C union, but a C struct i.e. a concrete
  // value for each type listed here must be provided when the attribute is
  // created.
  list<Value> Values = ValuesParam;

  // Documentation for this attribute. This is used to generate the HTML
  // documentation.
  code Documentation = [{}];
}

def DeviceModuleFlags
    : Attr<[Value<TTID, "TTID">,
            Value<StringRef, "Name">]> {
  let Documentation = [{
This attribute contains some information about a module generated by a tapir
target. This attribute should only be added to modules generated by a tapir
target. This is intended to be similiar, in principle, to the
`llvm.module.flags` metadata.

This should be added to ensure that the module name can be restored when it is
deserialized from the global variable into which it is embedded. Without this,
the name of the module is lost. While it is not wrong if the module does not
have an identifier, having a name is easier for debugging.

Currently, the TTID of the tapir target that generated the module is also part
of the attribute value. In the future, this may be expanded to include other
information if having them is determined to be useful.
}];
}

def LoopsAnnotated : Attr<[]> {
  let Documentation = [{
The presence of this attribute indicates that the `kit-annotate-prelower`
pass has been run on the module.
}];
}

def LoopsSerialized : Attr<[]> {
  let Documentation = [{
The presence of this attribute indicates that the `kit-serialize` pass has been
run on the module.
}];
}
